rules_version = '2';
// Version 2 data model. Legacy token-keyed locations and notes are denied.
// deviceAccounts/{uid}: ownerUid (immutable UID), fcmToken (1..4096 chars),
//   updatedAt (server timestamp). Only the owner and trusted backend read this.
// pairingApprovals/{uid}: ownerUid (immutable UID), partnerUid (1..128 chars,
//   another UID), updatedAt (server timestamp). Each owner approves ONE partner.
// pairingRequests/{targetUid}/requesters/{requesterUid}: backend-only pending
//   request containing requesterUid, targetUid, requesterName, and createdAt.
//   Callable Functions mediate all access; clients are denied by default.
// locationsV2/{uid}: ownerUid (immutable UID), updatedAt (server timestamp),
//   optional note (0..100 chars), optional complete location group: latitude
//   [-90,90], longitude [-180,180], accuracy [0,100000], timestamp (server
//   timestamp), batteryPercent (integer -1..100), isCharging (boolean).
// pairNotes/{firstUid}/partners/{secondUid}/entries/{id}: firstUid < secondUid;
//   senderId, targetId (pair UIDs), text (1..100 chars), timestamp (server time).
//   Callable Functions create notes and allow sender edits for the first 3 minutes.
// pairNotes/{firstUid}/partners/{secondUid}/noteGuards/{id}: backend-only
//   senderId, noteId, lastPostedAt. Blocks matching text for 10 minutes.
//   Pair parent paths are namespaces, not stored documents.
// Mutual approval grants live location/history access; revocation ends it.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function validUid(uid) {
      return uid is string && uid.size() > 0 && uid.size() <= 128
        && !uid.matches('.*[/].*');
    }
    function uidUnchanged(data) { return data.ownerUid == request.auth.uid; }
    function uidNotModified() {
      return request.resource.data.ownerUid == resource.data.ownerUid;
    }
    function mutuallyApproved(a, b) {
      return a != b
        && get(/databases/$(database)/documents/pairingApprovals/$(a)).data.partnerUid == b
        && get(/databases/$(database)/documents/pairingApprovals/$(b)).data.partnerUid == a;
    }
    function isValidDevice(data) {
      return data.keys().hasAll(['ownerUid', 'fcmToken', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'fcmToken', 'updatedAt'])
        && validUid(data.ownerUid) && uidUnchanged(data)
        && data.fcmToken is string && data.fcmToken.size() > 0
        && data.fcmToken.size() <= 4096
        && data.updatedAt == request.time;
    }
    function isValidApproval(data) {
      return data.keys().hasAll(['ownerUid', 'partnerUid', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'partnerUid', 'updatedAt'])
        && validUid(data.ownerUid) && uidUnchanged(data)
        && validUid(data.partnerUid) && data.partnerUid != data.ownerUid
        && data.updatedAt == request.time;
    }
    function geoFields() {
      return ['latitude', 'longitude', 'accuracy', 'timestamp', 'batteryPercent', 'isCharging'];
    }
    function isValidLocation(data) {
      return data.keys().hasAll(['ownerUid', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'updatedAt', 'note', 'latitude',
          'longitude', 'accuracy', 'timestamp', 'batteryPercent', 'isCharging'])
        && validUid(data.ownerUid) && uidUnchanged(data)
        && data.updatedAt == request.time
        && (!('note' in data) || (data.note is string && data.note.size() <= 100))
        && (!data.keys().hasAny(geoFields()) || (
          data.keys().hasAll(geoFields())
          && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
          && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
          && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100000
          && data.timestamp is timestamp && data.timestamp <= request.time
          && data.batteryPercent is int && data.batteryPercent >= -1 && data.batteryPercent <= 100
          && data.isCharging is bool));
    }
    function pairMember(a, b) {
      return isAuthenticated() && (request.auth.uid == a || request.auth.uid == b)
        && validUid(a) && validUid(b) && a < b && mutuallyApproved(a, b);
    }
    match /deviceAccounts/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && isValidDevice(request.resource.data);
      allow update: if isOwner(uid) && uidNotModified() && isValidDevice(request.resource.data);
      allow delete: if isOwner(uid);
    }
    match /pairingApprovals/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && isValidApproval(request.resource.data);
      allow update: if isOwner(uid) && uidNotModified() && isValidApproval(request.resource.data);
      allow delete: if isOwner(uid);
    }
    match /locationsV2/{uid} {
      allow get: if isOwner(uid) || (isAuthenticated() && mutuallyApproved(request.auth.uid, uid));
      allow create: if isOwner(uid) && isValidLocation(request.resource.data)
        && (!('timestamp' in request.resource.data) || request.resource.data.timestamp == request.time);
      allow update: if isOwner(uid) && uidNotModified() && isValidLocation(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(geoFields())
          || request.resource.data.timestamp == request.time);
      allow delete: if isOwner(uid);
    }
    match /pairNotes/{a}/partners/{b}/entries/{noteId} {
      allow get: if pairMember(a, b);
      allow list: if pairMember(a, b) && request.query.limit != null && request.query.limit <= 100;
      allow create, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
